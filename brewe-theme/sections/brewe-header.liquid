{%- if section.settings.announcement != blank -%}
  <div class="announcement">{{ section.settings.announcement }}</div>
{%- endif -%}
<header class="site-header">
  <div class="container header-inner">
    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name }}">BREW<span>É</span></a>

    {%- assign shop_url = collections['alle-produkte'].url | default: routes.all_products_collection_url -%}
    <nav class="nav" aria-label="Hauptnavigation">
      {%- assign menu = linklists[section.settings.menu] -%}
      {%- if menu.links.size > 0 -%}
        {%- for link in menu.links -%}
          {%- if link.links.size > 0 -%}
            <div class="nav-item has-dropdown">
              <a href="{{ link.url }}"{% if link.active or link.child_active %} aria-current="page"{% endif %}>{{ link.title }} <span class="caret" aria-hidden="true">▾</span></a>
              <div class="dropdown">
                {%- for child in link.links -%}
                  <a href="{{ child.url }}">{{ child.title }}</a>
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <a href="{{ shop_url }}">Shop</a>
        <a href="{{ routes.root_url }}#ritual">Ritual</a>
        <a href="{{ routes.root_url }}#about">Über uns</a>
      {%- endif -%}
    </nav>

    <div class="header-actions">
      <a href="{{ routes.search_url }}" class="icon-btn" aria-label="Suche">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="icon-btn" aria-label="{{ 'general.cart' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M5 8h14l-1.2 12H6.2L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
      <button class="icon-btn menu-toggle" data-menu-toggle aria-expanded="false" aria-label="Menü">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 9h16M4 15h16"/></svg>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Ankündigung", "default": "Kostenloser Versand ab 49 € · Frisch geröstet" },
    { "type": "link_list", "id": "menu", "label": "Menü", "default": "main-menu" }
  ]
}
{% endschema %}

<section class="page-hero">
  <div class="container">
    <h1 class="display" data-split>{%- if template.name == '404' -%}404{%- else -%}{{ page.title }}{%- endif -%}</h1>
  </div>
</section>
<section class="section" style="padding-top:10px">
  <div class="container">
    {%- if template.name == '404' -%}
      <div style="text-align:center" data-reveal>
        <p style="color:var(--muted)">Diese Seite gibt es nicht – aber Kaffee gibt es immer.</p>
        <a href="{{ routes.root_url }}" class="btn" data-magnetic>Zur Startseite</a>
      </div>
    {%- else -%}
      <div class="rte" data-reveal>{{ page.content }}</div>
      {%- if page.handle == 'kontakt' or page.handle == 'contact' or page.template_suffix == 'contact' -%}
        <div class="contact-wrap" data-reveal>
          {%- form 'contact', class: 'contact-form' -%}
            {%- if form.posted_successfully? -%}
              <p class="form-success">Danke für deine Nachricht! Wir melden uns innerhalb von 24 Stunden.</p>
            {%- else -%}
              {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
              <div class="field-row">
                <label class="field"><span>Name</span><input type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name"></label>
                <label class="field"><span>E-Mail *</span><input type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required></label>
              </div>
              <label class="field"><span>Bestellnummer (optional)</span><input type="text" name="contact[order]"></label>
              <label class="field"><span>Nachricht *</span><textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea></label>
              <button type="submit" class="btn" data-magnetic>Nachricht senden <span class="arrow">→</span></button>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Seite" }
{% endschema %}

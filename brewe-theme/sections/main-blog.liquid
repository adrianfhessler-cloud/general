{%- paginate blog.articles by 9 -%}
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-reveal>Stories & Guides</span>
      <h1 class="display" data-split>{{ blog.title }}</h1>
    </div>
  </section>
  <section class="section" style="padding-top:20px">
    <div class="container article-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card" data-tilt data-reveal style="--d: {{ forloop.index0 | modulo: 3 | times: 0.12 }}s">
          <div class="article-media">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}
            {%- else -%}
              {%- render 'brewe-placeholder', kind: 'cup' -%}
            {%- endif -%}
          </div>
          <div class="article-body">
            <span class="type">{{ article.published_at | date: '%d.%m.%Y' }}</span>
            <h2>{{ article.title }}</h2>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            <span class="read-more">Weiterlesen →</span>
          </div>
        </a>
      {%- else -%}
        <p style="color:var(--muted)">Bald gibt es hier neue Geschichten.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Seiten">
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}<span class="current">{{ part.title }}</span>
          {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog" }
{% endschema %}

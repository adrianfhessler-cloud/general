{%- assign collection = collections[section.settings.collection] -%}
{%- assign products = collection.products -%}
{%- if collection == blank -%}{%- assign products = collections.all.products -%}{%- endif -%}

<section class="section" id="shop">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</span>
        <h2 class="display" data-split>{{ section.settings.title }}</h2>
      </div>
      <p data-reveal style="--d: .2s">{{ section.settings.copy }}</p>
    </div>

    <div class="product-grid">
      {%- for product in products limit: section.settings.limit -%}
        {%- assign delay = forloop.index0 | modulo: 3 | times: 0.12 -%}
        {%- render 'brewe-product-card', product: product, delay: delay -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="product-card" data-tilt data-reveal style="--d: {{ forloop.index0 | times: 0.12 }}s">
            <div class="product-media">{%- render 'brewe-placeholder', kind: 'bag' -%}</div>
            <div class="product-info"><div><span class="type">Espresso Blend</span><h3>Produkt {{ i }}</h3></div><span class="product-price">—</span></div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    <div style="text-align:center;margin-top:64px" data-reveal>
      <a href="{{ collection.url | default: routes.all_products_collection_url }}" class="btn btn--ghost" data-magnetic>Alle Produkte <span class="arrow">→</span></a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produkt-Showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "title", "label": "Titel", "default": "Brew Your Moment." },
    { "type": "textarea", "id": "copy", "label": "Text", "default": "Frisch gerösteter Spezialitätenkaffee und präzises Equipment – kuratiert für den perfekten Shot." },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "limit", "label": "Anzahl", "min": 3, "max": 12, "step": 3, "default": 6 }
  ],
  "presets": [{ "name": "Produkt-Showcase" }]
}
{% endschema %}

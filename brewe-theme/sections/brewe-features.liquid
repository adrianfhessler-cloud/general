<section class="section" id="about">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</span>
        <h2 class="display" data-split>{{ section.settings.title }}</h2>
      </div>
    </div>
    <div class="feature-grid">
      <div class="feature" data-reveal>
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3"><ellipse cx="24" cy="24" rx="12" ry="17" transform="rotate(25 24 24)"/><path d="M20 9c7 9 1 21 8 30"/></svg>
        <h3>Frisch geröstet</h3>
        <p>Kleine Chargen, geröstet in Deutschland und innerhalb von 48 Stunden versendet.</p>
      </div>
      <div class="feature" data-reveal style="--d:.12s">
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="20" cy="22" r="11"/><path d="M31 22h12M14 33v6h12v-6"/><circle cx="20" cy="22" r="5"/></svg>
        <h3>Barista-Equipment</h3>
        <p>Siebträger-Zubehör aus Edelstahl und Holz – präzise, langlebig, schön.</p>
      </div>
      <div class="feature" data-reveal style="--d:.24s">
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M10 20h26l-3 18a5 5 0 0 1-5 4H18a5 5 0 0 1-5-4l-3-18Z"/><path d="M36 24h3a5 5 0 0 1 0 10h-4M18 14c-2-3 2-4 0-8M26 14c-2-3 2-4 0-8"/></svg>
        <h3>Dein Ritual</h3>
        <p>Rezepte, Brühguides und Röstprofile, damit jeder Shot gelingt.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Versprechen",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why BREWÉ" },
    { "type": "text", "id": "title", "label": "Titel", "default": "Barista Quality. At Home." }
  ],
  "presets": [{ "name": "Versprechen" }]
}
{% endschema %}
